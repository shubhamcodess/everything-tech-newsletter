{
  "$defs": {
    "PublishedStory": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "body": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Body",
          "type": "array"
        },
        "comments": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comments"
        },
        "dek": {
          "minLength": 1,
          "title": "Dek",
          "type": "string"
        },
        "discuss_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discuss Url"
        },
        "discuss_via": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discuss Via"
        },
        "event": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event"
        },
        "full_text": {
          "default": false,
          "title": "Full Text",
          "type": "boolean"
        },
        "headline": {
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "ids": {
          "items": {
            "type": "integer"
          },
          "title": "Ids",
          "type": "array"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "points": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points"
        },
        "read_minutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read Minutes"
        },
        "signal": {
          "enum": [
            "must-read",
            "recommended",
            "notable"
          ],
          "title": "Signal",
          "type": "string"
        },
        "source_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Title"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "takeaways": {
          "items": {
            "type": "string"
          },
          "title": "Takeaways",
          "type": "array"
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "url": {
          "pattern": "^https?://",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "headline",
        "dek",
        "body",
        "topic",
        "signal",
        "url",
        "sources"
      ],
      "title": "PublishedStory",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "via": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A published edition, as parsed from editions/<date>/edition.md.",
  "properties": {
    "brief": {
      "items": {
        "type": "string"
      },
      "title": "Brief",
      "type": "array"
    },
    "candidates": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidates"
    },
    "date": {
      "minLength": 1,
      "title": "Date",
      "type": "string"
    },
    "edition": {
      "title": "Edition",
      "type": "integer"
    },
    "fetched": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fetched"
    },
    "full_text": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Full Text"
    },
    "generated_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated At"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sources_ok": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sources Ok"
    },
    "sources_total": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sources Total"
    },
    "stories": {
      "items": {
        "$ref": "#/$defs/PublishedStory"
      },
      "title": "Stories",
      "type": "array"
    }
  },
  "required": [
    "date",
    "edition",
    "brief",
    "stories"
  ],
  "title": "PublishedEdition",
  "type": "object",
  "x-schema-version": 1
}
